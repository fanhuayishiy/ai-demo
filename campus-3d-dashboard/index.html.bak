const windowXf = [];
const footprints = [];
const spokes = [];
const winGeo = new THREE.PlaneGeometry(1, 1);
const FACE = [
  { ry: 0, axis: 'z', sign: 1 },
  { ry: Math.PI, axis: 'z', sign: -1 },
  { ry: Math.PI / 2, axis: 'x', sign: 1 },
  { ry: -Math.PI / 2, axis: 'x', sign: -1 },
];
for (const b of BUILDINGS) {
