  body.position.y = -total / 2;
  g.add(body);
  b.height = total;
  body.add(box(b.w + 1.2, H_PLINTH, b.d + 1.2, matPlinth, 0, H_PLINTH / 2, 0));
  body.add(box(b.w, total - H_PLINTH, b.d, matWall, 0, H_PLINTH + (total - H_PLINTH) / 2, 0));
  const bandH = H_GROUND * 0.92;
  body.add(box(b.w + 0.34, bandH, b.d + 0.34, matBand, 0, H_PLINTH + bandH / 2, 0));
  body.add(box(b.w + 0.52, 0.26, b.d + 0.52, matPlinth, 0, H_PLINTH + bandH + 0.13, 0));
  body.add(box(b.w, 0.32, b.d, matPlinth, 0, total + 0.16, 0));
  const pp = 0.34, ph = 1.05, py = total + 0.32 + ph / 2;
  const ox = (b.w + 0.5) / 2 - pp / 2, oz = (b.d + 0.5) / 2 - pp / 2;
  body.add(box(b.w + 0.5, ph, pp, matWall, 0, py, oz));
  body.add(box(b.w + 0.5, ph, pp, matWall, 0, py, -oz));
