  body.add(box(2.4, 0.9, 2.4, matPlinth, -b.w * 0.26, total + 0.32 + 0.45, b.d * 0.1));
  if (b.floors >= 6) body.add(box(0.16, 4.2, 0.16, matBand, -b.w * 0.3, total + 0.32 + 2.1, -b.d * 0.28));
  const cw = Math.min(b.w * 0.62, 11), dep = 3.6;
