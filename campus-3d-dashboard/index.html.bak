  for (const f of FACE) {
    const span = f.axis === 'z' ? b.w : b.d;
    const out = (f.axis === 'z' ? b.d : b.w) / 2 + 0.1;
    const cols = Math.max(2, Math.round(span / 3.7));
    const step = span / cols;
    const winW = Math.min(2.35, step * 0.66);
    const q = new THREE.Quaternion().setFromEuler(new THREE.Euler(0, f.ry, 0));
    const rowBottom = total * 0.10;
    const rowHeight = (total * 0.80) / b.floors;
    const winH = rowHeight * 0.80;
    const rows = Array.from({ length: b.floors }, (_, k) => rowBottom + rowHeight * (k + 0.5));
    for (const wy of rows) {
      for (let i = 0; i < cols; i++) {
        const o = -span / 2 + step * (i + 0.5);
        const front = f.ry === 0;
        if (front && wy < H_PLINTH + H_GROUND && Math.abs(o) < 2.7) continue;
        const pos = f.axis === 'z'
          ? new THREE.Vector3(o, wy, f.sign * out)
