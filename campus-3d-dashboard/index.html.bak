const matWall = new THREE.MeshStandardMaterial({ color: PAL.wall, roughness: 0.72, metalness: 0.02, envMapIntensity: 0.5 });
const matPlinth = new THREE.MeshStandardMaterial({ color: PAL.plinth, roughness: 0.85, metalness: 0.02, envMapIntensity: 0.4 });
const matBand = new THREE.MeshStandardMaterial({ color: PAL.band, roughness: 0.6, metalness: 0.08, envMapIntensity: 0.6 });
const matGlass = new THREE.MeshStandardMaterial({ color: PAL.glass, roughness: 0.1, metalness: 0.3, envMapIntensity: 1.2 });
const matDoor = new THREE.MeshStandardMaterial({ color: 0x4b7d9a, roughness: 0.16, metalness: 0.4, envMapIntensity: 1.1 });
const buildingGroup = new THREE.Group();
