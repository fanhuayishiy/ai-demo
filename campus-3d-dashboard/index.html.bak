  const tx = ux === 0 ? Infinity : (b.w / 2) / Math.abs(ux);
  const tz = uz === 0 ? Infinity : (b.d / 2) / Math.abs(uz);
  const edgeT = Math.min(tx, tz);
  const ex = px - ux * edgeT, ez = pz - uz * edgeT;
  spokes.push({
    ax: ex - ux * 5.2, az: ez - uz * 5.2,
    bx: ux * rEnd, bz: uz * rEnd, wide: 3.8,
  });
}
