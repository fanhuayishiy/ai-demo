  for (const s of [-1, 1]) body.add(box(0.3, H_GROUND - 0.3, 0.3, matBand, s * (cw / 2 - 0.5), (H_PLINTH + H_GROUND - 0.3) / 2, b.d / 2 + dep - 0.5));
  body.add(box(cw * 0.86, 0.24, 1.6, matPlinth, 0, H_PLINTH - 0.12, b.d / 2 + 1));
