/* ============================================================
   7.6 周边道路系统 / 外层低多边形建筑群
   ============================================================ */
const CITY = { x: 130, z: 106, len: 272, wide: 7.6 };
const CITY_RING = { w: CITY.x * 2, d: CITY.z * 2, r: 46 };
const cityGroup = new THREE.Group();
scene.add(cityGroup);
const cityRoadSegments = [];
const yellowLineMat = new THREE.MeshStandardMaterial({ color: 0xf2c94c, roughness: 0.78, metalness: 0 });
function addCityDash(axis, fixed, offset, mat, dashLen, gapLen, markWidth) {
  const count = Math.floor(CITY.len / (dashLen + gapLen));
  const start = -CITY.len / 2;
  for (let i = 0; i < count; i++) {
    const t = start + dashLen / 2 + i * (dashLen + gapLen);
    const geo = axis === 'x'
      ? new THREE.PlaneGeometry(markWidth, dashLen).rotateX(-Math.PI / 2)
      : new THREE.PlaneGeometry(dashLen, markWidth).rotateX(-Math.PI / 2);
    const m = flatMesh(geo, mat, 0.056);
    if (axis === 'x') m.position.set(fixed + offset, 0.056, t);
    else m.position.set(t, 0.056, fixed + offset);
    cityGroup.add(m);
  }
}
function addCityRoad(axis, fixed) {
  const geo = axis === 'x'
    ? new THREE.PlaneGeometry(CITY.wide, CITY.len).rotateX(-Math.PI / 2)
    : new THREE.PlaneGeometry(CITY.len, CITY.wide).rotateX(-Math.PI / 2);
  const road = flatMesh(geo, asphaltMat, 0.051);
  if (axis === 'x') road.position.set(fixed, 0.051, 0);
  else road.position.set(0, 0.051, fixed);
  cityGroup.add(road);
  cityRoadSegments.push({ axis, fixed });
  for (const side of [-1, 1]) addCityDash(axis, fixed, side * (CITY.wide / 2 - 0.48), roadMarkMat, 3.2, 2.7, 0.16);
  addCityDash(axis, fixed, 0, yellowLineMat, 3.8, 3.1, 0.22);
}
addCityRoad('x', -CITY.x);
addCityRoad('x', CITY.x);
addCityRoad('z', -CITY.z);
addCityRoad('z', CITY.z);

const outerGroup = new THREE.Group();
scene.add(outerGroup);
const outerSpots = [];
const outerColors = [0xc7cccf, 0xd3d7d8, 0xbcc3c7, 0xdadfdc, 0xcfd2c8, 0xc2c9cc];
function createOuterBuilding(w, d, h, color) {
  const g = new THREE.Group();
  const bodyMat = new THREE.MeshStandardMaterial({ color, roughness: 0.92, metalness: 0, flatShading: true, envMapIntensity: 0.28 });
  const roofMat = new THREE.MeshStandardMaterial({ color: 0x95a0a5, roughness: 0.86, metalness: 0.02, flatShading: true });
  g.add(box(w, h, d, bodyMat, 0, h / 2, 0));
  const roofH = Math.min(2.2, h * 0.22);
  const roof = new THREE.Mesh(new THREE.ConeGeometry(Math.max(w, d) * 0.71, roofH, 4), roofMat);
  roof.position.y = h + roofH / 2 - 0.12;
  roof.rotation.y = Math.PI / 4;
  roof.castShadow = true;
  roof.receiveShadow = true;
  g.add(roof);
  g.add(box(w * 0.42, 0.22, 1.8, roofMat, 0, h * 0.22, d / 2 + 0.9));
  g.add(box(w * 0.16, h * 0.18, 0.16, matBand, 0, h * 0.09, d / 2 + 0.08));
  return g;
}
function outerBlocked(x, z, w, d) {
  const dl = Math.hypot(x, z);
  if (dl < 102 || dl > 252) return true;
  const ux = x / dl, uz = z / dl;
  const wallDist = radialDist(CAMPUS.w, CAMPUS.d, CAMPUS.r, ux, uz);
  const roadDist = radialDist(ROAD.w, ROAD.d, ROAD.r, ux, uz);
  if (Math.abs(dl - wallDist) < 8) return true;
  if (dl > roadDist - ROAD.wide / 2 - 6 && dl < roadDist + ROAD.wide / 2 + 6) return true;
  const half = Math.max(w, d) / 2;
  for (const rd of cityRoadSegments) {
    const ax = rd.axis === 'x' ? rd.fixed : -CITY.len / 2;
    const az = rd.axis === 'x' ? -CITY.len / 2 : rd.fixed;
    const bx = rd.axis === 'x' ? rd.fixed : CITY.len / 2;
    const bz = rd.axis === 'x' ? CITY.len / 2 : rd.fixed;
    if (distToSeg(x, z, ax, az, bx, bz) < CITY.wide / 2 + half + 2.8) return true;
  }
  return false;
}
{
  const rings = [
    { count: 20, offset: [16, 26], h: [8.5, 12.5], size: [12, 18] },
    { count: 20, offset: [34, 48], h: [5, 9], size: [10, 16] },
    { count: 20, offset: [56, 72], h: [4.5, 7.5], size: [9, 14] },
  ];
  for (const ring of rings) {
    let placed = 0;
    for (let attempt = 0; attempt < 180 && placed < ring.count; attempt++) {
      const aa = (attempt / ring.count) * Math.PI * 2 + rand(-0.045, 0.045);
      const ux = Math.cos(aa), uz = Math.sin(aa);
      const base = radialDist(CITY_RING.w, CITY_RING.d, CITY_RING.r, ux, uz);
      const dl = base + rand(ring.offset[0], ring.offset[1]);
      const x = ux * dl, z = uz * dl;
      const w = rand(ring.size[0], ring.size[1]);
      const d = rand(ring.size[0], ring.size[1]);
      const h = rand(ring.h[0], ring.h[1]);
      if (outerBlocked(x, z, w, d)) continue;
      let tooClose = false;
      for (const p of outerSpots) {
        if (Math.hypot(p.x - x, p.z - z) < Math.max(17, (w + p.w) / 2 + 4)) { tooClose = true; break; }
      }
      if (tooClose) continue;
      const color = outerColors[Math.floor(rnd() * outerColors.length)];
      const b = createOuterBuilding(w, d, h, color);
      b.position.set(x, 0, z);
      b.rotation.y = rand(-0.12, 0.12);
      outerGroup.add(b);
      outerSpots.push({ x, z, w, d });
      footprints.push({ x, z, yaw: b.rotation.y, hw: w / 2, hd: d / 2 });
      placed++;
    }
  }
}
/* ============================================================
   8. 树木：分层锥体树冠 + 圆柱树干
   ============================================================ */
function keepOut(x, z, pad) {
  const dl = Math.hypot(x, z);
  if (dl < 1e-3) return true;
  const ux = x / dl, uz = z / dl;
  if (dl < radialDist(RING.w, RING.d, RING.r, ux, uz) + pad) return true;
  const wallDist = radialDist(CAMPUS.w, CAMPUS.d, CAMPUS.r, ux, uz);
  const wallPad = Math.max(1.4, pad);
  if (Math.abs(dl - wallDist) < wallPad) return true;
  const roadDist = radialDist(ROAD.w, ROAD.d, ROAD.r, ux, uz);
  const roadPad = Math.max(1.2, pad);
  if (dl > roadDist - ROAD.wide / 2 - roadPad && dl < roadDist + ROAD.wide / 2 + roadPad) return true;
  if (Math.abs(x) < GATE.w / 2 + 4 && z > GATE.z - 16 && z < GATE.z + ROAD.wide + 8) return true;
  if (dl > 190) return true;
  for (const rd of cityRoadSegments) {
    const ax = rd.axis === 'x' ? rd.fixed : -CITY.len / 2;
    const az = rd.axis === 'x' ? -CITY.len / 2 : rd.fixed;
    const bx = rd.axis === 'x' ? rd.fixed : CITY.len / 2;
    const bz = rd.axis === 'x' ? CITY.len / 2 : rd.fixed;
    if (distToSeg(x, z, ax, az, bx, bz) < CITY.wide / 2 + pad) return true;
  }
  for (const f of footprints) {
    const c = Math.cos(-f.yaw), si = Math.sin(-f.yaw);
    const lx = (x - f.x) * c - (z - f.z) * si;
    const lz = (x - f.x) * si + (z - f.z) * c;
    if (Math.abs(lx) < f.hw + pad && Math.abs(lz) < f.hd + pad) return true;
  }
  for (const sp of spokes) {
    if (distToSeg(x, z, sp.ax, sp.az, sp.bx, sp.bz) < sp.wide / 2 + pad) return true;
  }
  return false;
}
const treeSpots = [];
{
  const tryAdd = (x, z, minGap) => {
    if (keepOut(x, z, 3.6)) return;
    for (const p of treeSpots) {
      if (Math.hypot(p.x - x, p.z - z) < minGap) return;
    }
    treeSpots.push({ x: x, z: z, h: rand(7, 14.5), r: rand(2.2, 4.2), tone: rnd() });
  };

  // 用带抖动的网格铺满可绿化区域；按校内、路侧、外围分区控制密度，
  // 避免以前按距离环带生成时树集中成块。
  const step = 7.4;
  const candidates = [];
  for (let gx = -26; gx <= 26; gx++) {
    for (let gz = -21; gz <= 21; gz++) {
      const x = gx * step + rand(-3.0, 3.0);
      const z = gz * step * 0.94 + rand(-3.0, 3.0);
      if (keepOut(x, z, 3.6)) continue;
      const dl = Math.hypot(x, z), ux = x / dl, uz = z / dl;
      const wallDist = radialDist(CAMPUS.w, CAMPUS.d, CAMPUS.r, ux, uz);
      const roadDist = radialDist(ROAD.w, ROAD.d, ROAD.r, ux, uz);
      const roadGap = Math.abs(dl - roadDist) - ROAD.wide / 2;
      let zone = 'outer', weight = 0.46;
      if (dl < wallDist - 4) {
        zone = 'inner';
        weight = 0.74;
      } else if (roadGap < 12) {
        zone = 'road';
        weight = 0.94;
      }
      candidates.push({ x: x, z: z, zone: zone, weight: weight });
    }
  }

  for (let i = candidates.length - 1; i > 0; i--) {
    const j = Math.floor(rnd() * (i + 1));
    [candidates[i], candidates[j]] = [candidates[j], candidates[i]];
  }
  for (const c of candidates) {
    if (treeSpots.length >= 238) break;
    if (rnd() > c.weight) continue;
    tryAdd(c.x, c.z, 5.8);
  }
}
document.getElementById('mTree').textContent = treeSpots.length;
{
  const LAYERS = 3;
  const trunkGeo = new THREE.CylinderGeometry(0.5, 0.68, 1, 8).translate(0, 0.5, 0);
  const coneGeo = new THREE.ConeGeometry(1, 1, 14).translate(0, 0.5, 0);
  const trunkMat = new THREE.MeshStandardMaterial({ color: PAL.trunk, roughness: 0.95, metalness: 0 });
  const leafMat = new THREE.MeshStandardMaterial({ color: PAL.leaf, roughness: 0.9, metalness: 0, envMapIntensity: 0.35, flatShading: true });
  const trunks = new THREE.InstancedMesh(trunkGeo, trunkMat, treeSpots.length);
  const crowns = new THREE.InstancedMesh(coneGeo, leafMat, treeSpots.length * LAYERS);
  trunks.castShadow = true;
  crowns.castShadow = true;
  trunks.receiveShadow = true;
  crowns.receiveShadow = true;
  const m = new THREE.Matrix4(), p = new THREE.Vector3(), q = new THREE.Quaternion(), s = new THREE.Vector3();
  const up = new THREE.Vector3(0, 1, 0);
  const col = new THREE.Color();
  for (let i = 0; i < treeSpots.length; i++) {
    const t = treeSpots[i];
    const trunkH = t.h * 0.32;
    trunks.setMatrixAt(i, m.compose(p.set(t.x, 0, t.z), q.identity(), s.set(t.r * 0.2, trunkH, t.r * 0.2)));
    col.setHSL(0.09, rand(0.24, 0.34), rand(0.24, 0.32));
    trunks.setColorAt(i, col);
    const crownH = t.h - trunkH;
    for (let k = 0; k < LAYERS; k++) {
      const f = k / LAYERS;
      const rad = t.r * (1 - f * 0.3);
      const y = trunkH + crownH * f * 0.6;
      crowns.setMatrixAt(i * LAYERS + k, m.compose(p.set(t.x, y, t.z), q.setFromAxisAngle(up, k * 0.8), s.set(rad, crownH * 0.54, rad)));
      col.setHSL(0.29 + t.tone * 0.05 - f * 0.02, 0.34 + f * 0.12, 0.24 + f * 0.11 + t.tone * 0.05);
      crowns.setColorAt(i * LAYERS + k, col);
    }
  }
  trunks.instanceMatrix.needsUpdate = true;
  crowns.instanceMatrix.needsUpdate = true;
  if (trunks.instanceColor) trunks.instanceColor.needsUpdate = true;
  if (crowns.instanceColor) crowns.instanceColor.needsUpdate = true;
  trunks.computeBoundingSphere();
  crowns.computeBoundingSphere();
  scene.add(trunks, crowns);
}
/* ============================================================
   9. 渐变草皮贴片点缀
   ============================================================ */
{
  for (const t of treeSpots) {
    const sc = t.r * rand(2.15, 3.15);
    const mesh = new THREE.Mesh(patchGeo, patchMats[Math.floor(rnd() * patchMats.length)]);
    mesh.scale.set(sc, sc * rand(0.62, 1), sc);
    mesh.position.set(t.x, 0.04, t.z);
    mesh.rotation.y = rand(0, Math.PI * 2);
    patchGroup.add(mesh);
  }
}
/* ============================================================
   10. HUD 交互
   ============================================================ */
const bRotate = document.getElementById('bRotate');
const bReset = document.getElementById('bReset');
const bShadow = document.getElementById('bShadow');
const bPatch = document.getElementById('bPatch');
const bCamera = document.getElementById('bCamera');
const bNight = document.getElementById('bNight');
const rSun = document.getElementById('rSun');
const oSun = document.getElementById('oSun');
let isPerspective = false;
function configureControls() {
  controls.enableDamping = true;
  controls.dampingFactor = 0.055;
  controls.minZoom = 0.55;
  controls.maxZoom = 4.5;
  controls.minDistance = 55;
  controls.maxDistance = 720;
  controls.minPolarAngle = 0.12;
  controls.maxPolarAngle = Math.PI * 0.47;
  controls.autoRotateSpeed = 0.5;
  controls.screenSpacePanning = false;
}
bRotate.addEventListener('click', () => {
  controls.autoRotate = !controls.autoRotate;
  bRotate.classList.toggle('on', controls.autoRotate);
});
bReset.addEventListener('click', () => {
  camera.position.copy(HOME.pos);
  controls.target.copy(HOME.target);
  camera.zoom = HOME.zoom;
  camera.updateProjectionMatrix();
  controls.update();
});
bShadow.addEventListener('click', () => {
  const on = !renderer.shadowMap.enabled;
  renderer.shadowMap.enabled = on;
  sun.castShadow = on;
  scene.traverse((o) => {
    if (!o.material) return;
    (Array.isArray(o.material) ? o.material : [o.material]).forEach((mm) => { mm.needsUpdate = true; });
  });
  bShadow.classList.toggle('on', on);
});
bPatch.addEventListener('click', () => {
  patchGroup.visible = !patchGroup.visible;
  bPatch.classList.toggle('on', patchGroup.visible);
});
rSun.addEventListener('input', () => {
  oSun.textContent = applySun(parseFloat(rSun.value));
  if (nightMode) applyNightMode(true);
});
bCamera.addEventListener('click', () => {
  const target = controls.target.clone();
  const position = camera.position.clone();
  const autoRotate = controls.autoRotate;
  controls.dispose();
  isPerspective = !isPerspective;
  camera = isPerspective ? perspectiveCamera : orthoCamera;
  camera.position.copy(position);
  controls = new OrbitControls(camera, renderer.domElement);
  controls.target.copy(target);
  configureControls();
  controls.autoRotate = autoRotate;
  controls.update();
  bCamera.textContent = isPerspective ? '切换正交' : '切换透视';
  bCamera.classList.toggle('on', isPerspective);
});
bNight.addEventListener('click', () => {
  applyNightMode(!nightMode);
});
addEventListener('resize', () => {
  aspect = innerWidth / innerHeight;
  orthoCamera.left = (-FRUSTUM * aspect) / 2;
  orthoCamera.right = (FRUSTUM * aspect) / 2;
  orthoCamera.top = FRUSTUM / 2;
  orthoCamera.bottom = -FRUSTUM / 2;
  orthoCamera.updateProjectionMatrix();
  perspectiveCamera.aspect = aspect;
  perspectiveCamera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
/* ============================================================
   11. 渲染循环
   ============================================================ */
const mFps = document.getElementById('mFps');
let last = performance.now(), frames = 0, acc = 0;
renderer.setAnimationLoop(() => {
  controls.update();
  renderer.render(scene, camera);
  const now = performance.now();
  frames++; acc += now - last; last = now;
  if (acc > 900) {
    mFps.textContent = Math.round((frames * 1000) / acc);
    frames = 0; acc = 0;
  }
});
requestAnimationFrame(() => document.getElementById('boot').classList.add('gone'));
</script>
</body>
</html>
