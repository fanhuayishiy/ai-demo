<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>校园 3D 可视化 · Campus Digital Twin</title>
<style>
  :root {
    --ink: #1e2a32;
    --ink-soft: #5d6f7a;
    --line: rgba(30, 42, 50, 0.12);
    --panel: rgba(255, 255, 255, 0.82);
    --accent: #2c6e8f;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; overflow: hidden; background: #cfe0ea; }
  body {
    font-family: -apple-system, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }
  #app { position: fixed; inset: 0; }
  canvas { display: block; }
  .panel {
    position: fixed;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    backdrop-filter: blur(10px);
    box-shadow: 0 6px 24px rgba(20, 40, 55, 0.10);
  }
  .head { top: 18px; left: 18px; padding: 13px 17px 14px; }
  .head h1 { margin: 0; font-size: 16px; letter-spacing: 0.2px; font-weight: 650; }
  .head p { margin: 5px 0 0; font-size: 11.5px; color: var(--ink-soft); letter-spacing: 0.3px; }
  .head .rule { height: 1px; background: var(--line); margin: 10px 0 9px; }
  .head .meta { display: flex; gap: 14px; font-size: 11px; color: var(--ink-soft); }
  .head .meta b { color: var(--accent); font-weight: 650; font-size: 13px; margin-right: 3px; }
  .modes { top: 18px; right: 18px; padding: 10px 12px; display: flex; align-items: center; gap: 8px; }
  .dock { bottom: 18px; left: 18px; padding: 12px 14px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; max-width: 620px; }
  .btn {
    font: inherit; font-size: 12px; color: var(--ink);
    padding: 7px 12px; border-radius: 7px; cursor: pointer;
    border: 1px solid var(--line); background: rgba(255, 255, 255, 0.9);
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .btn:hover { background: #fff; border-color: rgba(44, 110, 143, 0.4); }
  .btn.on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .sun { display: flex; align-items: center; gap: 9px; padding-left: 4px; }
  .sun label { font-size: 11.5px; color: var(--ink-soft); white-space: nowrap; }
  .sun output { font-size: 11.5px; color: var(--accent); font-variant-numeric: tabular-nums; width: 42px; }
  input[type=range] {
    -webkit-appearance: none; appearance: none; width: 132px; height: 3px;
    border-radius: 3px; background: linear-gradient(90deg, #f0b46a, #d8e8f0, #f0b46a); outline: none;
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 13px; height: 13px; border-radius: 50%;
    background: #fff; border: 2px solid var(--accent); cursor: pointer;
  }
  input[type=range]::-moz-range-thumb {
    width: 13px; height: 13px; border-radius: 50%; background: #fff;
    border: 2px solid var(--accent); cursor: pointer;
  }
  .tip { bottom: 18px; right: 18px; padding: 9px 13px; font-size: 11px; color: var(--ink-soft); letter-spacing: 0.2px; }
  .tip span + span::before { content: "·"; margin: 0 7px; color: rgba(93, 111, 122, 0.5); }
  #boot {
    position: fixed; inset: 0; z-index: 9; display: grid; place-items: center;
    background: linear-gradient(180deg, #e6f0f5, #cfdfe8); color: var(--ink-soft);
    font-size: 12.5px; letter-spacing: 1.5px; transition: opacity 0.6s ease;
  }
  #boot.gone { opacity: 0; pointer-events: none; }
  @media (max-width: 720px) {
    .head { top: 12px; left: 12px; right: 12px; }
    .modes { top: 122px; right: 12px; }
    .dock { left: 12px; right: 12px; bottom: 58px; max-width: none; }
    .tip { display: none; }
  }
</style>
</head>
<body>
<div id="app"></div>
<div id="boot">正在构建校园场景…</div>
<div class="panel head">
  <h1>校园三维可视化沙盘</h1>
  <p>CAMPUS DIGITAL TWIN · ISOMETRIC VIEW</p>
  <div class="rule"></div>
  <div class="meta">
    <div><b>8</b>建筑</div>
    <div><b id="mTree">0</b>树木</div>
    <div><b>8</b>跑道</div>
    <div><b id="mFps">60</b>FPS</div>
  </div>
</div>
<div class="panel modes">
  <button class="btn" id="bCamera">切换透视</button>
  <button class="btn" id="bNight">切换夜景</button>
</div>
<div class="panel dock">
  <button class="btn" id="bRotate">自动巡航</button>
  <button class="btn" id="bReset">重置视角</button>
  <button class="btn on" id="bShadow">阴影</button>
  <button class="btn on" id="bPatch">草皮</button>
  <div class="sun">
    <label>日照</label>
    <input type="range" id="rSun" min="0" max="1" step="0.01" value="0.68" />
    <output id="oSun">15:31</output>
  </div>
</div>
<div class="panel tip">
  <span>左键拖拽旋转</span><span>滚轮缩放</span><span>右键平移</span>
</div>
<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/"
  }
}
</script>
<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
/* ============================================================
   0. 全局配置
   ============================================================ */
const PAL = {
  ground: 0x86ab6a,
  track: 0x3f7fcb,
  lane: 0xf3f7fa,
  wall: 0xf6f6f3,
  plinth: 0xd8dbd8,
  band: 0xbcc6c4,
  glass: 0xffffff,
  trunk: 0x7b5a3f,
  leaf: 0x4f8a4a,
  path: 0xe9e5da,
};
const TRACK = { w: 74, d: 46, r: 23, lanes: 8, laneW: 1.25 };
TRACK.width = TRACK.lanes * TRACK.laneW;
TRACK.in = { w: TRACK.w - TRACK.width * 2, d: TRACK.d - TRACK.width * 2, r: TRACK.r - TRACK.width };
const RING = { w: TRACK.w + 26, d: TRACK.d + 26, r: TRACK.r + 13, wide: 4.4 };
const CAMPUS = { w: 190, d: 150, r: 42 };
const GATE = { w: 20, z: CAMPUS.d / 2 };
const ROAD = { w: CAMPUS.w + 22, d: CAMPUS.d + 22, r: CAMPUS.r + 11, wide: 13 };
const BUILDINGS = [
  { name: '图书馆', ang: 202, w: 30, d: 18, floors: 4, far: 1.02 },
  { name: '教学楼A', ang: 246, w: 26, d: 13, floors: 5, far: 1.00 },
  { name: '教学楼B', ang: 292, w: 24, d: 13, floors: 5, far: 1.06 },
  { name: '行政楼', ang: 336, w: 21, d: 15, floors: 6, far: 1.00 },
  { name: '科研楼', ang: 24, w: 18, d: 14, floors: 7, far: 1.08 },
  { name: '体育馆', ang: 68, w: 27, d: 20, floors: 2, far: 1.00 },
  { name: '学生公寓', ang: 112, w: 16, d: 12, floors: 8, far: 1.10 },
  { name: '食堂', ang: 156, w: 24, d: 14, floors: 2, far: 1.02 },
];
const ELLIPSE = { a: 70, b: 54 };
const H_PLINTH = 0.55, H_GROUND = 4.4, H_FLOOR = 3.15;
/* ============================================================
   1. 工具函数
   ============================================================ */
function mulberry32(seed) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), 1 | t);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(20260916);
const rand = (min, max) => min + rnd() * (max - min);
function radialDist(w, d, r, ux, uz) {
  const hw = w / 2, hd = d / 2;
  r = Math.min(r, hw, hd);
  const iw = hw - r, iz = hd - r;
  let best = Infinity;
  if (Math.abs(ux) > 1e-6) {
    const t = (ux > 0 ? hw : -hw) / ux, z = uz * t;
    if (Math.abs(z) <= iz) best = Math.min(best, t);
  }
  if (Math.abs(uz) > 1e-6) {
    const t = (uz > 0 ? hd : -hd) / uz, x = ux * t;
    if (Math.abs(x) <= iw) best = Math.min(best, t);
  }
  const cx = ux > 0 ? iw : -iw, cz = uz > 0 ? iz : -iz;
  const b = ux * cx + uz * cz, c = cx * cx + cz * cz - r * r, disc = b * b - c;
  if (disc > 0) {
    const t = b + Math.sqrt(disc);
    if (t > 0) best = Math.min(best, t);
  }
  return best;
}
function distToSeg(px, pz, ax, az, bx, bz) {
  const vx = bx - ax, vz = bz - az;
  const len = vx * vx + vz * vz || 1e-6;
  const t = Math.max(0, Math.min(1, ((px - ax) * vx + (pz - az) * vz) / len));
  return Math.hypot(px - (ax + vx * t), pz - (az + vz * t));
}
function roundedRectSamples(w, d, r, seg = 10) {
  const hw = w / 2, hd = d / 2;
  r = Math.max(0.01, Math.min(r, hw, hd));
  const pts = [];
  const line = (x1, y1, x2, y2) => {
    for (let i = 0; i < seg; i++) {
      const t = i / seg;
      pts.push(new THREE.Vector2(x1 + (x2 - x1) * t, y1 + (y2 - y1) * t));
    }
  };
  const quad = (x1, y1, cx, cy, x2, y2) => {
    for (let i = 0; i < seg; i++) {
      const t = i / seg, u = 1 - t;
      pts.push(new THREE.Vector2(
        u * u * x1 + 2 * u * t * cx + t * t * x2,
        u * u * y1 + 2 * u * t * cy + t * t * y2,
      ));
    }
  };
  line(-hw + r, -hd, hw - r, -hd);
  quad(hw - r, -hd, hw, -hd, hw, -hd + r);
  line(hw, -hd + r, hw, hd - r);
  quad(hw, hd - r, hw, hd, hw - r, hd);
  line(hw - r, hd, -hw + r, hd);
  quad(-hw + r, hd, -hw, hd, -hw, hd - r);
  line(-hw, hd - r, -hw, -hd + r);
  quad(-hw, -hd + r, -hw, -hd, -hw + r, -hd);
  return pts;
}
function ringBand(w, d, r, from, to) {
  const outer = roundedRectSamples(w - from * 2, d - from * 2, r - from);
  const inner = roundedRectSamples(w - to * 2, d - to * 2, r - to);
  const n = outer.length, positions = [], normals = [], indices = [];
  for (let i = 0; i < n; i++) {
    positions.push(outer[i].x, 0, -outer[i].y, inner[i].x, 0, -inner[i].y);
    normals.push(0, 1, 0, 0, 1, 0);
  }
  for (let i = 0; i < n; i++) {
    const j = (i + 1) % n, a = i * 2, b = a + 1, c = j * 2, e = c + 1;
    indices.push(a, c, b, b, c, e);
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
  g.setAttribute('normal', new THREE.Float32BufferAttribute(normals, 3));
  g.setIndex(indices);
  return g;
}
function flatMesh(geo, mat, y) {
  const m = new THREE.Mesh(geo, mat);
  m.position.y = y;
  m.receiveShadow = true;
  return m;
}
function box(w, h, d, mat, x, y, z) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
  m.position.set(x, y, z);
  m.castShadow = true;
  m.receiveShadow = true;
  return m;
}
function canvasTexture(w, h, draw, repeat = 1) {
  const cv = document.createElement('canvas');
  cv.width = w; cv.height = h;
  draw(cv.getContext('2d'), w, h);
  const tex = new THREE.CanvasTexture(cv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(repeat, repeat);
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.anisotropy = 8;
  return tex;
}
/* ============================================================
   2. 渲染器 / 等距相机 / OrbitControls
   ============================================================ */
const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.02;
document.getElementById('app').appendChild(renderer.domElement);
const scene = new THREE.Scene();
scene.fog = new THREE.Fog(0xdfeef6, 210, 620);
const pmrem = new THREE.PMREMGenerator(renderer);
scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.05).texture;
const FRUSTUM = 186;
let aspect = innerWidth / innerHeight;
const orthoCamera = new THREE.OrthographicCamera(
  (-FRUSTUM * aspect) / 2, (FRUSTUM * aspect) / 2, FRUSTUM / 2, -FRUSTUM / 2, 1, 2400
);
const perspectiveCamera = new THREE.PerspectiveCamera(40, aspect, 1, 2400);
let camera = orthoCamera;
const HOME = { pos: new THREE.Vector3(158, 140, 158), target: new THREE.Vector3(0, 6, 0), zoom: 0.96 };
camera.position.copy(HOME.pos);
perspectiveCamera.position.copy(HOME.pos);
let controls = new OrbitControls(camera, renderer.domElement);
controls.target.copy(HOME.target);
controls.enableDamping = true;
controls.dampingFactor = 0.055;
controls.minZoom = 0.55;
controls.maxZoom = 4.5;
controls.minPolarAngle = 0.12;
controls.maxPolarAngle = Math.PI * 0.47;
controls.autoRotateSpeed = 0.5;
controls.screenSpacePanning = false;
controls.update();
/* ============================================================
   3. 天空渐变 + Directional / Ambient / Hemisphere 光照
   ============================================================ */
const skyMat = new THREE.ShaderMaterial({
  uniforms: {
    topColor: { value: new THREE.Color(0x86b6d6) },
    bottomColor: { value: new THREE.Color(0xe9f2f6) },
    offset: { value: 60 },
    exponent: { value: 0.72 },
  },
  vertexShader: [
    'varying vec3 vWorld;',
    'void main() {',
    '  vec4 wp = modelMatrix * vec4(position, 1.0);',
    '  vWorld = wp.xyz;',
    '  gl_Position = projectionMatrix * viewMatrix * wp;',
    '}',
  ].join('\n'),
  fragmentShader: [
    'uniform vec3 topColor;',
    'uniform vec3 bottomColor;',
    'uniform float offset;',
    'uniform float exponent;',
    'varying vec3 vWorld;',
    'void main() {',
    '  float h = max(normalize(vWorld + vec3(0.0, offset, 0.0)).y, 0.0);',
    '  gl_FragColor = vec4(mix(bottomColor, topColor, pow(h, exponent)), 1.0);',
    '}',
  ].join('\n'),
  side: THREE.BackSide,
  depthWrite: false,
  fog: false,
});
scene.add(new THREE.Mesh(new THREE.SphereGeometry(900, 32, 18), skyMat));
const hemi = new THREE.HemisphereLight(0xcfe6f3, 0x8a9a72, 0.85);
scene.add(hemi);
const ambient = new THREE.AmbientLight(0xffffff, 0.2);
scene.add(ambient);
const sun = new THREE.DirectionalLight(0xfff3e2, 2.4);
sun.castShadow = true;
sun.shadow.mapSize.set(4096, 4096);
sun.shadow.camera.near = 80;
sun.shadow.camera.far = 760;
sun.shadow.camera.left = -170;
sun.shadow.camera.right = 170;
sun.shadow.camera.top = 170;
sun.shadow.camera.bottom = -170;
sun.shadow.bias = -0.0004;
sun.shadow.normalBias = 0.05;
sun.shadow.radius = 2.2;
sun.position.set(150, 200, 110);
scene.add(sun, sun.target);
function applySun(t) {
  const elevDeg = 4 + 62 * Math.sin(Math.PI * t);
  const azimDeg = -104 + 208 * t;
  const elev = THREE.MathUtils.degToRad(elevDeg);
  const azim = THREE.MathUtils.degToRad(azimDeg);
  const R = 330, horiz = Math.cos(elev) * R;
  sun.position.set(horiz * Math.sin(azim), Math.sin(elev) * R, horiz * Math.cos(azim));
  const low = 1 - THREE.MathUtils.smoothstep(elevDeg, 5, 36);
  sun.color.setHSL(THREE.MathUtils.lerp(0.115, 0.055, low), THREE.MathUtils.lerp(0.1, 0.62, low), THREE.MathUtils.lerp(0.99, 0.72, low));
  sun.intensity = THREE.MathUtils.lerp(2.6, 1.3, low);
  ambient.intensity = THREE.MathUtils.lerp(0.19, 0.33, low);
  hemi.intensity = THREE.MathUtils.lerp(0.9, 0.55, low);
  renderer.toneMappingExposure = THREE.MathUtils.lerp(1.02, 1.16, low);
  const dusk = 1 - THREE.MathUtils.smoothstep(elevDeg, 8, 44);
  skyMat.uniforms.topColor.value.set(0x8ab4d8).lerp(new THREE.Color(0x71809b), dusk);
  skyMat.uniforms.bottomColor.value.set(0xeaf3f7).lerp(new THREE.Color(0xf5c68d), dusk);
  scene.fog.color.copy(skyMat.uniforms.bottomColor.value);
  const mins = Math.round(6 * 60 + t * 14 * 60);
  return String(Math.floor(mins / 60)).padStart(2, '0') + ':' + String(mins % 60).padStart(2, '0');
}
document.getElementById('oSun').textContent = applySun(0.68);
let nightMode = false;
function applyNightMode(on) {
  nightMode = on;
  if (on) {
    scene.background = new THREE.Color(0x162030);
    scene.fog.color.set(0x162030);
    skyMat.uniforms.topColor.value.set(0x0f1a28);
    skyMat.uniforms.bottomColor.value.set(0x162030);
    hemi.color.set(0x2f405e);
    hemi.groundColor.set(0x1b2531);
    hemi.intensity = 0.18;
    ambient.color.set(0x5a6a85);
    ambient.intensity = 0.10;
    sun.color.set(0xffb166);
    sun.intensity = 0.18;
    renderer.toneMappingExposure = 0.72;
    matGlass.emissive.set(0xffc06a);
    matGlass.emissiveIntensity = 0.78;
    lampBulbMat.emissiveIntensity = 2.6;
  } else {
    scene.background = null;
    oSun.textContent = applySun(parseFloat(rSun.value));
    matGlass.emissive.set(0x000000);
    matGlass.emissiveIntensity = 0;
    lampBulbMat.emissiveIntensity = 0.15;
  }
  bNight.classList.toggle('on', on);
  bNight.textContent = on ? '切换白天' : '切换夜景';
}
/* ============================================================
   4. 地面草皮
   ============================================================ */
const grassTex = canvasTexture(512, 512, (ctx, S) => {
  ctx.fillStyle = '#7fa768';
  ctx.fillRect(0, 0, S, S);
  for (let i = 0; i < 26000; i++) {
    const d = Math.random();
    ctx.fillStyle = d > 0.55 ? 'rgba(152,184,114,0.55)' : d > 0.28 ? 'rgba(94,132,76,0.5)' : 'rgba(198,208,152,0.35)';
    ctx.fillRect(Math.random() * S, Math.random() * S, 1.6, 1.6);
  }
}, 34);
const ground = flatMesh(
  new THREE.CircleGeometry(330, 96).rotateX(-Math.PI / 2),
  new THREE.MeshStandardMaterial({ color: PAL.ground, map: grassTex, roughness: 0.98, metalness: 0, envMapIntensity: 0.25 }),
  0
);
scene.add(ground);
function patchTexture(core, mid) {
  return canvasTexture(256, 256, (ctx, S) => {
    ctx.clearRect(0, 0, S, S);
    const g = ctx.createRadialGradient(S / 2, S / 2, S * 0.04, S / 2, S / 2, S * 0.5);
    g.addColorStop(0, core);
    g.addColorStop(0.45, mid);
    g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(S / 2, S / 2, S / 2, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 0.5;
    for (let i = 0; i < 900; i++) {
      const a = Math.random() * Math.PI * 2, rr = Math.sqrt(Math.random()) * S * 0.47;
      ctx.fillStyle = Math.random() > 0.5 ? 'rgba(255,255,255,0.10)' : 'rgba(40,70,35,0.16)';
      ctx.fillRect(S / 2 + Math.cos(a) * rr, S / 2 + Math.sin(a) * rr, 2, 3.2);
    }
  });
}
const patchGeo = new THREE.PlaneGeometry(1, 1).rotateX(-Math.PI / 2);
const patchMats = [
  patchTexture('rgba(112,158,86,0.85)', 'rgba(120,164,92,0.42)'),
  patchTexture('rgba(148,180,98,0.80)', 'rgba(138,170,96,0.38)'),
  patchTexture('rgba(86,132,72,0.80)', 'rgba(100,146,84,0.36)'),
].map((map) => new THREE.MeshStandardMaterial({
  map, transparent: true, roughness: 1, metalness: 0, depthWrite: false,
  polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -2,
}));
const patchGroup = new THREE.Group();
scene.add(patchGroup);
/* ============================================================
   5. 标准运动场
   ============================================================ */
const field = new THREE.Group();
scene.add(field);
const trackGeo = ringBand(TRACK.w, TRACK.d, TRACK.r, 0, TRACK.width);
const track = new THREE.Mesh(trackGeo, new THREE.MeshStandardMaterial({
  color: PAL.track, roughness: 0.92, metalness: 0.02, envMapIntensity: 0.35,
}));
track.castShadow = true;
track.receiveShadow = true;
track.position.y = 0.5;
field.add(track);
const laneMat = new THREE.MeshStandardMaterial({ color: PAL.lane, roughness: 0.85, metalness: 0, envMapIntensity: 0.2 });
for (let i = 0; i <= TRACK.lanes; i++) {
  const inset = i * TRACK.laneW;
  field.add(flatMesh(ringBand(TRACK.w, TRACK.d, TRACK.r, Math.max(0.01, inset - 0.08), inset + 0.08), laneMat, 0.51));
}
function pitchTexture() {
  const W = 1400, H = 680;
  const tex = canvasTexture(W, H, (ctx) => {
    const n = 12;
    for (let i = 0; i < n; i++) {
      ctx.fillStyle = i % 2 ? '#3d8c4d' : '#4a9d59';
      ctx.fillRect((W / n) * i, 0, W / n + 1, H);
    }
    ctx.globalAlpha = 0.15;
    for (let i = 0; i < 40000; i++) {
      ctx.fillStyle = Math.random() > 0.5 ? '#dff0d8' : '#1f5c32';
      ctx.fillRect(Math.random() * W, Math.random() * H, 1.5, 3);
    }
    ctx.globalAlpha = 1;
    const m = 46, fw = W - m * 2, fh = H - m * 2;
    ctx.strokeStyle = '#ffffff';
    ctx.fillStyle = '#ffffff';
    ctx.lineWidth = 5;
    ctx.strokeRect(m, m, fw, fh);
    ctx.beginPath(); ctx.moveTo(W / 2, m); ctx.lineTo(W / 2, H - m); ctx.stroke();
    const arcR = fh * 0.145;
    ctx.beginPath(); ctx.arc(W / 2, H / 2, arcR, 0, Math.PI * 2); ctx.stroke();
    ctx.beginPath(); ctx.arc(W / 2, H / 2, 6, 0, Math.PI * 2); ctx.fill();
    const pad = fh * 0.165, pdd = fw * 0.115;
    const gad = fh * 0.075, gdd = fw * 0.042;
    for (const side of [1, -1]) {
      const gx = side === 1 ? m : W - m;
      const px = gx + side * pdd;
      const sx = gx + side * (fh * 0.11);
      ctx.strokeRect(Math.min(gx, px), H / 2 - pad / 2, pdd, pad);
      ctx.strokeRect(Math.min(gx, gx + side * gdd), H / 2 - gad / 2, gdd, gad);
      ctx.beginPath(); ctx.arc(sx, H / 2, 5, 0, Math.PI * 2); ctx.fill();
      const dx = Math.abs(px - sx);
      if (arcR > dx) {
        const th = Math.acos(dx / arcR);
        ctx.beginPath();
        if (side === 1) ctx.arc(sx, H / 2, arcR, -th, th);
        else ctx.arc(sx, H / 2, arcR, Math.PI - th, Math.PI + th);
        ctx.stroke();
      }
      ctx.lineWidth = 6;
      ctx.beginPath(); ctx.moveTo(gx, H / 2 - fh * 0.058); ctx.lineTo(gx, H / 2 + fh * 0.058); ctx.stroke();
      ctx.lineWidth = 5;
    }
    const cr = 22;
    const corners = [[m, m, 0], [W - m, m, Math.PI / 2], [W - m, H - m, Math.PI], [m, H - m, -Math.PI / 2]];
    for (const c of corners) {
      ctx.beginPath(); ctx.arc(c[0], c[1], cr, c[2], c[2] + Math.PI / 2); ctx.stroke();
    }
  });
  tex.wrapS = tex.wrapT = THREE.ClampToEdgeWrapping;
  tex.repeat.set(1, 1);
  return tex;
}
